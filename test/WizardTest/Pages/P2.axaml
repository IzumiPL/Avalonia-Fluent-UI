<UserControl
  x:Class="WizardTest.Pages.P2"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <StackPanel
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Orientation="Horizontal"
    Spacing="24">
    <TextBlock
      HorizontalAlignment="Right"
      VerticalAlignment="Center"
      FontSize="168"
      Text="🤗"/>
    <StackPanel
      VerticalAlignment="Center"
      Orientation="Vertical"
      Spacing="6">
      <TextBlock Classes="Title" Text="Hugging Face 配置"/>
      <TextBlock
        FontSize="12"
        Foreground="Gray"
        Text="访问令牌"/>
      <TextBox
        Name="TokenEdit"
        MinWidth="256"
        PlaceholderText="请输入访问令牌(tk_1)"/>
      <TextBlock
        FontSize="12"
        Foreground="Gray"
        Text="代理服务器"/>
      <TextBox
        Name="ProxyEdit"
        MinWidth="256"
        PlaceholderText="请输入代理服务区地址(locale)"/>
    </StackPanel>
  </StackPanel>
</UserControl>

