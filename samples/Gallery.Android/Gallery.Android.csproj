<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <Authors>Izumi</Authors>
    <ApplicationTitle>Gallery</ApplicationTitle>
    <ApplicationId>com.avaloniafluentui.gallery</ApplicationId>
    <ApplicationVersion>114</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <NoWarn>CA1416;CA1422</NoWarn>
  </PropertyGroup>


  <PropertyGroup>
    <RunAOTCompilation>true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>     
    <TrimMode>partial</TrimMode>                 
    <StripSymbols>true</StripSymbols>        
    <DebuggerSupport>false</DebuggerSupport> 
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gallery\Gallery.csproj" />
  </ItemGroup>
</Project>
