<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Gallery</AssemblyName>
    <RootNamespace>Gallery</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Fonts\**;Assets\Locale\**"/>
<!--    <AvaloniaResource Include="Assets\**" Exclude="Assets\Locale\**"/>-->
    
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="../../src/AvaloniaFluentUI/AvaloniaFluentUI.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="Pages\StatusAndInformationPage\ToolTipPage.axaml.cs">
      <DependentUpon>ToolTipPage.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Pages\StatusAndInformationPage\InformationPage.axaml.cs">
      <DependentUpon>InfoBadge.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Pages\StatusAndInformationPage\InfoBarPage.axaml.cs">
      <DependentUpon>InfoBarPage.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Pages\StatusAndInformationPage\ProgressPage.axaml.cs">
      <DependentUpon>ProgressPage.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
</Project>
