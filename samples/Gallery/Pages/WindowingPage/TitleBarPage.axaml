<ui:InfoBarHostViewBase
  x:Class="Gallery.Pages.TitleBarPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fi="clr-namespace:AvaloniaFluentUI.Icons;assembly=AvaloniaFluentUI"
  xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
  xmlns:locale="clr-namespace:AvaloniaFluentUI.Locale;assembly=AvaloniaFluentUI"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:page="clr-namespace:Gallery.Pages"
  xmlns:ui="clr-namespace:Gallery.Controls"
  xmlns:viewModel="clr-namespace:Gallery.ViewModels"
  xmlns:wnd="clr-namespace:AvaloniaFluentUI.Windowing;assembly=AvaloniaFluentUI"
  Title="{Binding Title}"
  d:DesignWidth="800"
  x:DataType="viewModel:TitleBarPageViewModel"
  mc:Ignorable="d">

  <ui:ViewBase.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </ui:ViewBase.Styles>

  <StackPanel Spacing="50">
    <ui:CodeCard Name="FluentTitleBarCard" Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[FluentTitleBar]}">
      <Grid ColumnDefinitions="*, Auto">
        <Border
          Margin="0,0,24,0"
          VerticalAlignment="Center"
          BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
          BorderThickness="1.5"
          CornerRadius="6">
          <wnd:FluentTitleBar
            Title="{Binding #TitleBox.Text}"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            ContentIsVisible="{Binding #CVTS.IsChecked}"
            Icon="avares://Gallery/Assets/app.ico"
            IconIsVisible="{Binding #IVTS.IsChecked}"
            IconSize="{Binding #ISBox.Value}"
            TitleIsVisible="{Binding #TVTS.IsChecked}">
            <Grid ColumnDefinitions="*, Auto">
              <fui:SearchTextBox
                MinWidth="256"
                VerticalAlignment="Center"
                PlaceholderText="Search..."/>
              <fui:Avatar
                Grid.Column="1"
                Width="32"
                Height="32"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                IsCircular="True"
                Text="H"/>
            </Grid>
          </wnd:FluentTitleBar>
        </Border>

        <ui:Card Grid.Column="1" MinWidth="256">
          <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Text="Title"/>
            <TextBox
              Name="TitleBox"
              HorizontalAlignment="Stretch"
              Classes="Clear"
              Text="Avalonia Fluent UI Gallery"/>

            <TextBlock Text="Icon size"/>
            <fui:NumberBox
              Name="ISBox"
              HorizontalAlignment="Stretch"
              Maximum="100"
              Minimum="0"
              Value="16"/>

            <TextBlock Text="IsIconVisible"/>
            <ToggleSwitch Name="IVTS" IsChecked="True"/>

            <TextBlock Text="IsTitleVisible"/>
            <ToggleSwitch Name="TVTS" IsChecked="True"/>

            <TextBlock Text="ContentVisible"/>
            <ToggleSwitch Name="CVTS" IsChecked="True"/>
          </StackPanel>
        </ui:Card>
      </Grid>
      <!--  1  -->
    </ui:CodeCard>
  </StackPanel>
</ui:InfoBarHostViewBase>
