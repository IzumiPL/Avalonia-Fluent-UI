<ui:InfoBarHostViewBase
  x:Class="Gallery.Pages.FluentWindowPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fi="clr-namespace:AvaloniaFluentUI.Icons;assembly=AvaloniaFluentUI"
  xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
  xmlns:locale="clr-namespace:AvaloniaFluentUI.Locale;assembly=AvaloniaFluentUI"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:page="clr-namespace:Gallery.Pages"
  xmlns:ui="clr-namespace:Gallery.Controls"
  xmlns:viewModel="clr-namespace:Gallery.ViewModels"
  Title="{Binding Title}"
  d:DesignWidth="800"
  x:DataType="viewModel:FluentWindowPageViewModel"
  mc:Ignorable="d">

  <ui:ViewBase.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </ui:ViewBase.Styles>

  <StackPanel Spacing="50">
    <ui:CodeCard Name="FluentWindowCard" Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[FluentWindow]}">
      <Grid ColumnDefinitions="*, Auto">
        <Button Click="OnShowWindow" Content="Show window"/>
        <ui:Card Grid.Column="1">
          <Grid
            ColumnDefinitions="*, *"
            ColumnSpacing="6"
            RowDefinitions="Auto, Auto, Auto, Auto,Auto ,Auto, Auto, Auto"
            RowSpacing="6">
            <TextBlock
              Grid.Row="0"
              Grid.ColumnSpan="2"
              Text="Window title"/>
            <TextBox
              Name="TitleBox"
              Grid.Row="1"
              Grid.ColumnSpan="2"
              Classes="Clear"
              Text="Title"/>

            <TextBlock
              Grid.Row="2"
              Grid.ColumnSpan="2"
              Text="Window size"/>
            <TextBlock
              Grid.Row="3"
              Grid.Column="0"
              Text="Width"/>
            <TextBlock
              Grid.Row="3"
              Grid.Column="1"
              Text="Height"/>
            <NumericUpDown
              Name="WidthNumericUpDown"
              Grid.Row="4"
              Grid.Column="0"
              Maximum="2400"
              Minimum="100"
              Value="800"/>
            <NumericUpDown
              Name="HeightNumericUpDown"
              Grid.Row="4"
              Grid.Column="1"
              Maximum="1400"
              Minimum="100"
              Value="520"/>

            <TextBlock
              Grid.Row="5"
              Grid.ColumnSpan="2"
              Text="Window position"/>
            <TextBlock
              Grid.Row="6"
              Grid.Column="0"
              Text="X"/>
            <TextBlock
              Grid.Row="6"
              Grid.Column="1"
              Text="Y"/>
            <NumericUpDown
              Name="XNumericUpDown"
              Grid.Row="7"
              Grid.Column="0"
              Maximum="2400"
              Minimum="100"
              Value="100"/>
            <NumericUpDown
              Name="YNumericUpDown"
              Grid.Row="7"
              Grid.Column="1"
              Maximum="1400"
              Minimum="100"
              Value="100"/>
          </Grid>
        </ui:Card>
      </Grid>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[FluentWindow]}">
      <Grid ColumnDefinitions="*, Auto">
        <Button Click="OnShowCustomWindow" Content="Show window"/>

        <ui:Card Grid.Column="1">
          <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Text="IsAlwaysOnTop"/>
            <ToggleSwitch Name="AOTTS" IsChecked="True"/>

            <TextBlock Text="IsMaximizable"/>
            <ToggleSwitch Name="MATS" IsChecked="True"/>

            <TextBlock Text="IsMinimizable"/>
            <ToggleSwitch Name="MITS" IsChecked="True"/>

            <TextBlock Text="IsResizable"/>
            <ToggleSwitch Name="RTS" IsChecked="True"/>

            <TextBlock Text="IsMaxButtonVisible"/>
            <ToggleSwitch Name="MABVTS" IsChecked="True"/>

            <TextBlock Text="IsMinButtonVisible"/>
            <ToggleSwitch Name="MIBVTS" IsChecked="True"/>

            <TextBlock Text="IsCloseButtonVisible"/>
            <ToggleSwitch Name="CBVTS" IsChecked="True"/>

            <TextBlock Text="IsIconVisible"/>
            <ToggleSwitch Name="IVTS" IsChecked="True"/>

            <TextBlock Text="IsTitleVisible"/>
            <ToggleSwitch Name="TVTS" IsChecked="True"/>
          </StackPanel>
        </ui:Card>
      </Grid>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[FluentWindow]}">
      <Button
        VerticalAlignment="Center"
        Click="OnShowFullscreenWindow"
        Content="Show window(Fullscreen mode)"/>
    </ui:CodeCard>
  </StackPanel>
</ui:InfoBarHostViewBase>
