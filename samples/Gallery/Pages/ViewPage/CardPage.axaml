<ui:ViewBase
  x:Class="Gallery.Pages.CardPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fi="clr-namespace:AvaloniaFluentUI.Icons;assembly=AvaloniaFluentUI"
  xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
  xmlns:locale="clr-namespace:AvaloniaFluentUI.Locale;assembly=AvaloniaFluentUI"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:Gallery.Models"
  xmlns:ui="clr-namespace:Gallery.Controls"
  xmlns:viewModel="clr-namespace:Gallery.ViewModels"
  Title="{Binding Title}"
  d:DesignWidth="800"
  x:DataType="viewModel:CardPageViewModel"
  mc:Ignorable="d">

  <ui:ViewBase.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </ui:ViewBase.Styles>

  <StackPanel Spacing="50">
    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_CardTitle]}">
      <fui:Card>
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_CardTitle]}"/>
      </fui:Card>
    </ui:CodeCard>


    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SimpleCardTitle]}">
      <fui:SimpleCard>
        <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SimpleCardTitle]}"/>
      </fui:SimpleCard>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_ElevatedCardTitle]}">
      <StackPanel
        Margin="8,10"
        Orientation="Horizontal"
        Spacing="16">
        <fui:ElevatedCard Width="256" Height="256">
          <Panel>
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="86"
              Text="🥰"/>
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Classes="SubTitle"
              Text="Kiss"/>
          </Panel>
        </fui:ElevatedCard>
        <fui:ElevatedCard Width="256" Height="256">
          <Panel>
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="86"
              Text="🥵"/>
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Classes="SubTitle"
              Text="Kiss"/>
          </Panel>
        </fui:ElevatedCard>
        <fui:ElevatedCard Width="256" Height="256">
          <Panel>
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="86"
              Text="😭"/>
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Classes="SubTitle"
              Text="Kiss"/>
          </Panel>
        </fui:ElevatedCard>
      </StackPanel>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_HeaderCardTitle]}">
      <fui:HeaderCard Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SystemReq]}">
        <Panel Height="52">
          <Panel
            Width="18"
            Height="18"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Ellipse
              Name="IconBackground"
              Width="18"
              Height="18"
              VerticalAlignment="Top"
              Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
            <fui:FontIcon
              Width="18"
              Height="18"
              VerticalAlignment="Top"
              FontFamily="{StaticResource SymbolThemeFontFamily}"
              FontSize="10"
              Foreground="{DynamicResource TextFillColorInverseBrush}"
              Glyph="&#xE10B;"/>
          </Panel>
          <SelectableTextBlock
            Margin="24,0,0,0"
            VerticalAlignment="Top"
            Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SystemReqDes]}"
            TextWrapping="WrapWithOverflow"/>
          <fui:HyperlinkLabel VerticalAlignment="Bottom" Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SystemReqDesMoreInfo]}"/>
          <!--  <HyperlinkButton  -->
          <!--  Margin="-11,0,0,0"  -->
          <!--  VerticalAlignment="Bottom"  -->
          <!--  Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SystemReqDesMoreInfo]}"/>  -->
        </Panel>
      </fui:HeaderCard>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[GroupHeaderCard]}">
      <fui:GroupHeaderCard Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[BasicSettings]}">
        <fui:GroupHeaderCardItem
          Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[SelOtDir]}"
          Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[BuildDirectory]}"
          IconSize="32"
          IconSource="avares://Gallery/Assets/Icons/光辉矢愿_瞄准.png">
          <Button Width="128" Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[Selected]}"/>
        </fui:GroupHeaderCardItem>
        <fui:GroupHeaderCardItem
          Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[IsShowTer]}"
          Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[RunTer]}"
          IconSize="32"
          IconSource="avares://Gallery/Assets/Icons/昔涟_收到.png">
          <ComboBox SelectedIndex="0">
            <ComboBoxItem Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[AS]}"/>
            <ComboBoxItem Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[NAS]}"/>
          </ComboBox>
        </fui:GroupHeaderCardItem>
        <fui:GroupHeaderCardItem
          Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[SeSfIptSc]}"
          Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[IptSc]}"
          IconSize="32"
          IconSource="avares://Gallery/Assets/Icons/帕姆_注意.png">
          <fui:SearchTextBox MinWidth="256" PlaceholderText="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[IptIpPath]}"/>
        </fui:GroupHeaderCardItem>
        <fui:GroupHeaderCardItem
          DescriptionIsVisible="False"
          Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[CliBuiPack]}"
          IconSize="32"
          IconSource="avares://Gallery/Assets/Icons/光辉矢愿_遨游.png">
          <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="6">
            <fui:PushButton Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[MT_Open]}" IconSource="{x:Static fi:FluentIcon.View}"/>
            <fui:PushButton
              Classes="Accent"
              Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[Compile]}"
              IconSource="{x:Static fi:FluentIcon.Play}"/>
          </StackPanel>
        </fui:GroupHeaderCardItem>
      </fui:GroupHeaderCard>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SimpleSettingsCard]}">
      <fui:SettingCard
        Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SoundDescription]}"
        Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_Volume]}"
        IconSource="{x:Static fi:FluentIcon.Volume}">
        <fui:ToolTipSlider
          Width="168"
          MinHeight="0"
          MaxHeight="100"
          Value="32"/>
      </fui:SettingCard>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_NoIconCardTitle]}">
      <fui:SettingCard Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SoundDescription]}" Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_Volume]}">
        <ToggleSwitch Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_NoIconCardTitleSwc]}"/>
      </fui:SettingCard>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_CICardTitle]}">
      <fui:SettingCard
        Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SoundDescription]}"
        Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_Volume]}"
        IconSource="avares://Gallery/Assets/Icons/Setting.png">
        <ToggleSwitch Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_NoIconCardTitleSwc]}"/>
      </fui:SettingCard>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_ClickableSettingsCard]}">
      <fui:ExpanderSettingCard
        ActionIconSource="ChevronRight"
        Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_SoundDescription]}"
        Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_Sound]}"
        IconSource="Volume"/>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_ExpandableSettingsCard]}">
      <fui:ExpanderSettingCard
        Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_AppsSettingsDescription]}"
        Header="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_ChooseDevice]}"
        IconSource="Microphone">
        <fui:ExpanderSettingCardItem Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_Headset]}" Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_DeviceName]}"/>
        <fui:ExpanderSettingCardItem Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_HasFooterContent]}" Description="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_DeviceName]}">
          <fui:ExpanderSettingCardItem.Footer>
            <fui:PushButton
              Classes="Accent"
              Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_AddDevice]}"
              IconSource="{DynamicResource Add}"/>
          </fui:ExpanderSettingCardItem.Footer>
        </fui:ExpanderSettingCardItem>
        <fui:ExpanderSettingCardItem
          ActionIconSource="ChevronRight"
          Content="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_IsClickable]}"
          IsClickEnabled="True"/>
      </fui:ExpanderSettingCard>
    </ui:CodeCard>
  </StackPanel>
</ui:ViewBase>
