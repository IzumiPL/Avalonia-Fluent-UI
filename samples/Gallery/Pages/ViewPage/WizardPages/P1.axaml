<UserControl
  x:Class="Gallery.Pages.P1"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:locale="clr-namespace:AvaloniaFluentUI.Locale;assembly=AvaloniaFluentUI"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <StackPanel
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Orientation="Horizontal"
    Spacing="24">
    <TextBlock FontSize="168" Text="👋"/>
    <StackPanel
      VerticalAlignment="Center"
      Orientation="Vertical"
      Spacing="6">
      <TextBlock Classes="Title" Text="{locale:Localization WeApply}"/>
      <TextBlock
        FontSize="12"
        Foreground="Gray"
        Text="{locale:Localization StartConf}"/>
      <Button
        Classes="Transparent"
        Content="{locale:Localization ImportConf}"
        Foreground="{DynamicResource SystemAccentColor}"/>
    </StackPanel>
  </StackPanel>
</UserControl>

