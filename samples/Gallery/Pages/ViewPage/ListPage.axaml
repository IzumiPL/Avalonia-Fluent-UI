<ui:ViewBase
  x:Class="Gallery.Pages.ListPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fi="clr-namespace:AvaloniaFluentUI.Icons;assembly=AvaloniaFluentUI"
  xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
  xmlns:locale="clr-namespace:AvaloniaFluentUI.Locale;assembly=AvaloniaFluentUI"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="clr-namespace:Gallery.Controls"
  xmlns:viewModel="clr-namespace:Gallery.ViewModels"
  Title="{Binding Title}"
  d:DesignWidth="800"
  x:DataType="viewModel:ListPageViewModel"
  mc:Ignorable="d">

  <ui:ViewBase.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </ui:ViewBase.Styles>

  <StackPanel Spacing="50">
    <ui:CodeCard Name="ListBoxCard" Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_ListControl]}">
      <ListBox
        Height="328"
        HorizontalAlignment="Stretch"
        ItemsSource="{Binding ItemSource}"/>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_RoundListBox]}">
      <fui:RoundListBox
        Height="328"
        HorizontalAlignment="Stretch"
        ItemsSource="{Binding ItemSource}"/>
    </ui:CodeCard>

    <ui:CodeCard Title="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TableView]}">
      <TableView
        MaxHeight="486"
        Margin="6"
        ItemsSource="{Binding TableDatas}">
        <TableView.Columns>
          <TableViewColumn
            HorizontalContentAlignment="Center"
            Binding="{Binding ID}"
            Header="ID"/>
          <TableViewColumn
            HorizontalContentAlignment="Center"
            Binding="{Binding Name}"
            Header="Name"/>
          <TableViewColumn
            HorizontalContentAlignment="Center"
            Binding="{Binding Age}"
            Header="Age"/>
          <TableViewColumn
            HorizontalContentAlignment="Center"
            Binding="{Binding Gender}"
            Header="Gender"/>
          <TableViewColumn
            HorizontalContentAlignment="Center"
            Binding="{Binding Phone}"
            Header="Phone"/>
          <TableViewColumn HorizontalContentAlignment="Center" Header="Working">
            <TableViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsActive}"/>
              </DataTemplate>
            </TableViewColumn.CellTemplate>
          </TableViewColumn>
        </TableView.Columns>
      </TableView>
    </ui:CodeCard>
  </StackPanel>
</ui:ViewBase>
