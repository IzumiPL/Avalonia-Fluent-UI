<ui:ViewBase
  x:Class="Gallery.Pages.TimeLinePage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:fi="clr-namespace:AvaloniaFluentUI.Icons;assembly=AvaloniaFluentUI"
  xmlns:fui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI"
  xmlns:locale="clr-namespace:AvaloniaFluentUI.Locale;assembly=AvaloniaFluentUI"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="clr-namespace:Gallery.Controls"
  xmlns:viewModel="clr-namespace:Gallery.ViewModels"
  Title="{Binding Title}"
  d:DesignWidth="800"
  x:DataType="viewModel:TimeLinePageViewModel"
  mc:Ignorable="d">

  <ui:ViewBase.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </ui:ViewBase.Styles>

  <StackPanel Spacing="50">
    <ui:CodeCard Title="{Binding Title}">
      <fui:TimeLine
        Width="666"
        Padding="15"
        HorizontalAlignment="Left">
        <fui:TimeLineItem>
          <fui:TimeLineItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fui:InfoBadge Classes="Success Icon"/>
              <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TimeLineCompleted]}"/>
            </StackPanel>
          </fui:TimeLineItem.Header>
          <fui:Card>
            <Panel>
              <fui:InfoBadge HorizontalAlignment="Left" Classes="Success Icon"/>
              <TextBlock
                Margin="32,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TimeLineAllOut]}"
                TextDecorations="Strikethrough"/>
            </Panel>
          </fui:Card>
        </fui:TimeLineItem>
        <fui:TimeLineItem>
          <fui:TimeLineItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fui:InfoBadge Classes="Attention Icon"/>
              <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TimeLineTodaySchedule]}"/>
            </StackPanel>
          </fui:TimeLineItem.Header>
          <StackPanel Orientation="Vertical" Spacing="6">
            <fui:Card>
              <Panel>
                <fui:InfoBadge HorizontalAlignment="Left" Classes="Warning Icon"/>
                <TextBlock
                  Margin="32,0,0,0"
                  VerticalAlignment="Center"
                  Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TimeLineUploadMv]}"/>
              </Panel>
            </fui:Card>
            <fui:Card>
              <Panel>
                <fui:InfoBadge HorizontalAlignment="Left" Classes="Warning Icon"/>
                <TextBlock
                  Margin="32,0,0,0"
                  VerticalAlignment="Center"
                  Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TimeLineDownloadSong]}"/>
              </Panel>
            </fui:Card>
          </StackPanel>
        </fui:TimeLineItem>
        <fui:TimeLineItem>
          <fui:TimeLineItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fui:InfoBadge Classes="Error Icon"/>
              <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TimeLineTodo]}"/>
            </StackPanel>
          </fui:TimeLineItem.Header>
          <fui:Card>
            <Panel>
              <fui:InfoBadge HorizontalAlignment="Left" Classes="Error Icon"/>
              <TextBlock
                Margin="32,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static locale:LocalizationService.Instance}, Path=[VP_TimeLineLoopNewSong]}"/>
            </Panel>
          </fui:Card>
        </fui:TimeLineItem>
      </fui:TimeLine>
    </ui:CodeCard>
  </StackPanel>
</ui:ViewBase>
