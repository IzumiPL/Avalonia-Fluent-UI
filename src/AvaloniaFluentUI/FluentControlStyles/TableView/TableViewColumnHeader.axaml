<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:ClassModifier="internal">

  <Design.PreviewWith>
    <Border
      Margin="20"
      BorderBrush="LightGray"
      BorderThickness="1">
      <TableViewColumnHeader Content="Header"/>
    </Border>
  </Design.PreviewWith>

  <Thickness x:Key="TableViewColumnResizerMargin">0,0,-6,0</Thickness>
  <Thickness x:Key="TableViewColumnHeaderPadding">11, 2</Thickness>
  <x:Double x:Key="TableViewColumnResizerWidth">12</x:Double>
  <x:Double x:Key="TableViewColumnHeaderHeight">30</x:Double>
  <x:Double x:Key="TableViewColumnHeaderFontSize">14</x:Double>
  <HorizontalAlignment x:Key="TableViewColumnHeaderHorizontalAlignment">Center</HorizontalAlignment>

  <ControlTemplate x:Key="TableViewColumnHeaderResizerTemplate" TargetType="Thumb">
    <Border Background="Transparent">
      <Rectangle
        Width="1"
        HorizontalAlignment="Center"
        Fill="{DynamicResource DividerStrokeColorDefaultBrush}"/>
    </Border>
  </ControlTemplate>

  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Height" Value="{DynamicResource TableViewColumnHeaderHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource TableViewColumnHeaderPadding}"/>
    <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter
            Name="PART_ContentPresenter"
            Padding="{TemplateBinding Padding}"
            HorizontalAlignment="{DynamicResource TableViewColumnHeaderHorizontalAlignment}"
            VerticalAlignment="Center"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource TableViewColumnHeaderFontSize}"/>
                <Setter Property="FontWeight" Value="{TemplateBinding FontWeight}"/>
                <Setter Property="FontFamily" Value="{TemplateBinding FontFamily}"/>
              </Style>
            </ContentPresenter.Styles>
          </ContentPresenter>
          <Thumb
            Name="PART_Resizer"
            Width="{DynamicResource TableViewColumnResizerWidth}"
            Margin="{DynamicResource TableViewColumnResizerMargin}"
            HorizontalAlignment="Right"
            Cursor="SizeWestEast"
            IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}"
            Template="{StaticResource TableViewColumnHeaderResizerTemplate}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
