<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fi="clr-namespace:AvaloniaFluentUI.Icons;assembly=AvaloniaFluentUI"
  xmlns:ui="clr-namespace:AvaloniaFluentUI.Controls;assembly=AvaloniaFluentUI">

  <ControlTheme x:Key="{x:Type ui:ToastInfoBar}" TargetType="ui:ToastInfoBar">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHighBrush}"/>
    <Setter Property="BorderThickness" Value="1 1 1 1"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="CornerRadius" Value="6"/>

    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Name="PART_RootBorder"
          MinHeight="45"
          MaxWidth="{TemplateBinding MaxWidth}"
          MaxHeight="{TemplateBinding MaxHeight}"
          Margin="{DynamicResource ControlDefaultBoxShadowsMargin}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          BoxShadow="{DynamicResource PopupDefaultBoxShadow}"
          CornerRadius="{TemplateBinding CornerRadius,
                                         Converter={StaticResource KeepTopCornerRadiusConverter}}">
          <Border
            Margin="0,5,0,0"
            Background="{DynamicResource PopupControlBackgroundBrush}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Opacity="1">
            <Grid
              Name="PART_Layout"
              Margin="{TemplateBinding Padding}"
              VerticalAlignment="Center">
              <TextBlock
                Name="PART_TitleText"
                Grid.Row="0"
                Grid.Column="0"
                Classes="StrongBody"
                Text="{TemplateBinding Title}"
                TextTrimming="CharacterEllipsis"/>
              <ContentPresenter
                Name="ContentPresenter"
                Grid.Row="1"
                Margin="0,-8,5,0"
                Content="{TemplateBinding Content}"
                FontSize="13"
                TextWrapping="Wrap"/>

              <ui:ToolButton
                Name="PART_CloseButton"
                Grid.Row="0"
                Grid.Column="1"
                Width="32"
                Height="32"
                Margin="6,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Classes="Transparent"
                Content="{x:Static fi:FluentIcon.Close}"
                Cursor="Hand"
                Foreground="{TemplateBinding Foreground}"
                IconHeight="10"
                IconWidth="10"
                IsVisible="{TemplateBinding IsClosable}"/>
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsClosable=False]">
      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Margin" Value="0 2 5 0"/>
      </Style>
    </Style>

    <Style Selector="^[Orientation=Horizontal]">
      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Grid.Row" Value="0"/>
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="Margin" Value="12 6 5 0"/>
      </Style>

      <Style Selector="^ /template/ TextBlock#PART_TitleText">
        <Setter Property="Margin" Value="0 6 0 0"/>
      </Style>

      <Style Selector="^ /template/ ui|ToolButton#PART_CloseButton">
        <Setter Property="Grid.Column" Value="2"/>
      </Style>

      <Style Selector="^[IsClosable=False]">
        <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
          <Setter Property="Margin" Value="12 2 5 0"/>
        </Style>

        <Style Selector="^ /template/ TextBlock#PART_TitleText">
          <Setter Property="Margin" Value="0 1 0 0"/>
        </Style>
      </Style>
    </Style>

    <Style Selector="^[Severity=Informational]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBrush}"/>
    </Style>

    <Style Selector="^[Severity=Success]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
    </Style>

    <Style Selector="^[Severity=Warning]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}"/>
    </Style>

    <Style Selector="^[Severity=Error]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
