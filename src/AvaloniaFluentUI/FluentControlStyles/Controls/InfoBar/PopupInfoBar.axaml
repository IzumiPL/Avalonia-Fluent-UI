<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fi="clr-namespace:AvaloniaFluentUI.Icons"
  xmlns:ui="clr-namespace:AvaloniaFluentUI.Controls">

  <Thickness x:Key="PopupInfoBarMargin">0,3.5,14,0</Thickness>

  <ControlTheme x:Key="{x:Type ui:PopupInfoBar}" TargetType="ui:PopupInfoBar">
    <Setter Property="Background" Value="{DynamicResource PopupControlBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHighBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10 10 5 10"/>
    <Setter Property="CornerRadius" Value="6"/>

    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Name="PART_RootBorder"
          MinHeight="45"
          MaxWidth="{TemplateBinding MaxWidth}"
          MaxHeight="{TemplateBinding MaxHeight}"
          Margin="{DynamicResource ControlDefaultBoxShadowsMargin}"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          BoxShadow="{DynamicResource PopupDefaultBoxShadow}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Grid
            Name="PART_Layout"
            Margin="{TemplateBinding Padding}"
            VerticalAlignment="Center">
            <Panel
              Name="IconArea"
              Grid.Row="0"
              Grid.Column="0"
              Margin="0,-1,0,0">
              <Ellipse
                Name="IconBackground"
                Width="16"
                Height="16"
                Margin="{DynamicResource PopupInfoBarMargin}"
                VerticalAlignment="Top"/>

              <ui:FontIcon
                Name="Icon"
                Margin="{DynamicResource PopupInfoBarMargin}"
                VerticalAlignment="Top"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="10"/>
            </Panel>
            <TextBlock
              Name="PART_TitleText"
              Grid.Row="0"
              Grid.Column="1"
              Margin="-5,0,0,0"
              Classes="StrongBody"
              Text="{TemplateBinding Title}"
              TextTrimming="CharacterEllipsis"/>
            <ContentPresenter
              Name="ContentPresenter"
              Grid.Row="1"
              Grid.Column="1"
              Margin="-5,-10,5,0"
              Content="{TemplateBinding Content}"
              FontSize="13"
              TextWrapping="Wrap"/>

            <ui:ToolButton
              Name="PART_CloseButton"
              Grid.Row="0"
              Grid.Column="2"
              Width="32"
              Height="32"
              Margin="6,0,0,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Classes="Transparent"
              Content="{x:Static fi:FluentIcon.Close}"
              Cursor="Hand"
              Foreground="{TemplateBinding Foreground}"
              IconHeight="10"
              IconWidth="10"
              IsVisible="{TemplateBinding IsClosable}"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Orientation=Horizontal]">
      <Setter Property="Padding" Value="10 8 5 8"/>

      <Style Selector="^[IsClosable=False]">
        <Setter Property="Padding" Value="10 8 5 14"/>
      </Style>

      <Style Selector="^ /template/ Panel#IconArea">
        <Setter Property="Margin" Value="0 4.5 0 0"/>
      </Style>

      <Style Selector="^ /template/ TextBlock#PART_TitleText">
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="Margin" Value="-5 7 0 0"/>
      </Style>

      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Grid.Row" Value="0"/>
        <Setter Property="Grid.Column" Value="2"/>
        <Setter Property="Margin" Value="12 6 5 0"/>
      </Style>

      <Style Selector="^ /template/ ui|ToolButton#PART_CloseButton">
        <Setter Property="Grid.Column" Value="3"/>
      </Style>
    </Style>

    <Style Selector="^[Severity=Informational]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/>

      <Style Selector="^ /template/ Ellipse#IconBackground">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
      </Style>

      <Style Selector="^ /template/ ui|FontIcon#Icon">
        <Setter Property="Glyph" Value="&#x0069;"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}"/>
      </Style>
    </Style>

    <Style Selector="^[Severity=Success]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>

      <Style Selector="^ /template/ Ellipse#IconBackground">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
      </Style>

      <Style Selector="^ /template/ ui|FontIcon#Icon">
        <Setter Property="Glyph" Value="&#xE10B;"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}"/>
        <Setter Property="Margin" Value="0,6,14,0"/>
      </Style>
    </Style>

    <Style Selector="^[Severity=Warning]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>

      <Style Selector="^ /template/ Ellipse#IconBackground">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
      </Style>

      <Style Selector="^ /template/ ui|FontIcon#Icon">
        <Setter Property="Glyph" Value="&#x0021;"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}"/>
      </Style>
    </Style>

    <Style Selector="^[Severity=Error]">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>

      <Style Selector="^ /template/ Ellipse#IconBackground">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
      </Style>

      <Style Selector="^ /template/ ui|FontIcon#Icon">
        <Setter Property="Glyph" Value="&#xE10A;"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}"/>
        <Setter Property="Margin" Value="0,6,14,0"/>
      </Style>
    </Style>

    <Style Selector="^[Severity=Custom]">
      <Style Selector="^ /template/ Panel#IconArea">
        <Setter Property="IsVisible" Value="False"/>
      </Style>

      <Style Selector="^[IsClosable=True]">
        <Setter Property="Padding" Value="20 10 5 10"/>
      </Style>

      <Style Selector="^[IsClosable=False]">
        <Setter Property="Padding" Value="20 10 5 14"/>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
