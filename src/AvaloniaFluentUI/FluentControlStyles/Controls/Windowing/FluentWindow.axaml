<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:AvaloniaFluentUI.Controls"
  xmlns:wnd="clr-namespace:AvaloniaFluentUI.Windowing">

  <ControlTheme x:Key="{x:Type wnd:AppSplashScreen}" TargetType="wnd:AppSplashScreen">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter
          Name="ContentHost"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          Background="{TemplateBinding Background}"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="FluentWindowDecorations" TargetType="WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="45"/>
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>
          <WindowDrawnDecorationsContent.Underlay>
            <Panel Name="PART_UnderlayWrapper">
              <Border
                Name="PART_WindowBorder"
                Background="Transparent"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="{TemplateBinding FrameThickness}"
                IsHitTestVisible="False"/>
              <!--  Titlebar: background, title text, and drag area live in underlay  -->
              <Panel
                Name="PART_TitleBar"
                Height="{TemplateBinding TitleBarHeight}"
                VerticalAlignment="Top"
                Background="Transparent"
                IsVisible="{TemplateBinding HasTitleBar}"
                WindowDecorationProperties.ElementRole="TitleBar"/>
            </Panel>
          </WindowDrawnDecorationsContent.Underlay>

          <WindowDrawnDecorationsContent.Overlay/>

          <WindowDrawnDecorationsContent.FullscreenPopover/>

        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type wnd:FluentWindow}" TargetType="wnd:FluentWindow">
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource ApplicationPageBackgroundThemeBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}"/>
    <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
    <Setter Property="Background" Value="{DynamicResource ApplicationPageBackgroundThemeBrush}"/>
    <Setter Property="WindowDecorationsTheme" Value="{StaticResource FluentWindowDecorations}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="ExtendClientAreaToDecorationsHint" Value="True"/>
    <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="-1"/>
    <Setter Property="WindowDecorations" Value="{OnPlatform BorderOnly, Windows=Full, Linux=None, x:TypeArguments=WindowDecorations}"/>

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <VisualLayerManager Name="PART_VisualLayerManager">
            <Border
              Name="RootBorder"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              ClipToBounds="{TemplateBinding ClipToBounds}"
              CornerRadius="{TemplateBinding CornerRadius}">
              <!--  BorderBrush="{DynamicResource ControlStrokeColorDefault}"  -->
              <Panel>
                <wnd:FluentTitleBar
                  x:Name="PART_FluentTitleBar"
                  Title="{TemplateBinding Title}"
                  Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.Height}"
                  Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.Margin}"
                  Content="{TemplateBinding TitleBarContent}"
                  ContentIsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.ContentIsVisible}"
                  ContentMargin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.ContentMargin}"
                  ContentTemplate="{TemplateBinding TitleBarContentTemplate}"
                  Icon="{TemplateBinding Icon}"
                  IconIsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.IconIsVisible}"
                  IconSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.IconSize}"
                  IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.IsVisible}"
                  TitleIsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.TitleIsVisible}"/>

                <ContentPresenter
                  Name="PART_ContentPresenter"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ClipToBounds="False"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"/>

                <!--  Overlay: only interactive caption buttons  -->
                <Panel Name="PART_OverlayWrapper" ZIndex="999">
                  <!--  Title text lives in overlay so it renders above client content  -->
                  <StackPanel
                    Name="PART_OverlayPanel"
                    Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarTemplateSettings.Height}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{Binding ElementName=PART_FluentTitleBar, Path=Background}"
                    Orientation="Horizontal"
                    TextElement.FontSize="10">
                    <Button
                      Name="PART_MinimizeButton"
                      Classes="CaptionButton"
                      Classes.inactive="{Binding !$parent[wnd:FluentWindow].IsActive}"
                      Content="&#xE738;"
                      IsEnabled="{Binding $parent[wnd:FluentWindow].CanMinimize}"
                      IsVisible="{TemplateBinding MinButtonIsVisible}"
                      Theme="{StaticResource FluentDrawnCaptionButton}"
                      WindowDecorationProperties.ElementRole="MinimizeButton"/>

                    <Button
                      Name="PART_MaximizeButton"
                      Classes="CaptionButton"
                      Classes.inactive="{Binding !$parent[wnd:FluentWindow].IsActive}"
                      Content="&#xE739;"
                      IsEnabled="{Binding $parent[wnd:FluentWindow].CanMaximize}"
                      IsVisible="{TemplateBinding MaxButtonIsVisible}"
                      Theme="{StaticResource FluentDrawnCaptionButton}"
                      WindowDecorationProperties.ElementRole="MaximizeButton"/>

                    <Button
                      Name="PART_CloseButton"
                      Classes="Close CaptionButton"
                      Classes.inactive="{Binding !$parent[wnd:FluentWindow].IsActive}"
                      Content="&#xE711;"
                      FontSize="16"
                      IsVisible="{TemplateBinding CloseButtonIsVisible}"
                      Theme="{StaticResource FluentDrawnCaptionButton}"
                      WindowDecorationProperties.ElementRole="CloseButton"/>
                  </StackPanel>
                </Panel>

                <wnd:AppSplashScreen Name="SplashHost" IsVisible="False"/>
              </Panel>
            </Border>
          </VisualLayerManager>

          <ui:InfoBarHost Name="InfoBarHost" Margin="0,60,0,0"/>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- <Style Selector="^ /template/ Grid#PART_DefaultTitleBar"> -->
    <!-- <Setter Property="Transitions"> -->
    <!-- <Transitions> -->
    <!--  <ThicknessTransition  -->
    <!--  Easing="CubicEaseOut"  -->
    <!--  Property="Margin"  -->
    <!--  Duration="0:0:0.114"/>  -->
    <!-- </Transitions> -->
    <!-- </Setter> -->
    <!-- </Style> -->

    <Style Selector="^[WindowState=Maximized],     ^[WindowState=FullScreen]">
      <Style Selector="^ /template/ Button#PART_MaximizeButton">
        <Setter Property="Content" Value="&#xE923;"/>
        <Setter Property="FontSize" Value="16"/>
      </Style>

      <Style Selector="^ /template/ Border#RootBorder">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>
    </Style>

    <Style Selector="^[IsActive=False]">
      <Style Selector="^ /template/ wnd|FluentTitleBar#PART_FluentTitleBar,       ^ /template/ TextBlock#TitleText">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
      </Style>
    </Style>

    <Style Selector="^:splash-open">
      <Style Selector="^ /template/ wnd|AppSplashScreen#SplashHost">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
    </Style>

    <Style Selector="^:is-windows-10">
      <!--  TODO: 在windows10上设置圆角边框会出现黑线, 暂未找到解决方法, 暂时退回直角边框, 后续找到解决方法再改回圆角!  -->
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHighBrush}"/>
    </Style>

    <Style Selector="^:is-not-windows">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderHighBrush}"/>

      <Style Selector="^ /template/ Button#PART_CloseButton">
        <Setter Property="CornerRadius" Value="0 6 0 0"/>
      </Style>

      <Style Selector="^[WindowState=Maximized],     ^[WindowState=FullScreen]">
        <Style Selector="^ /template/ Button#PART_CloseButton">
          <Setter Property="CornerRadius" Value="0"/>
        </Style>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
